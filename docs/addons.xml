<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="plugin.video.samlight" name="[COLOR red]Sam Light[/COLOR]" provider-name="Sam" version="2.1.7.2">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.pil" version="1.1.7"/>
        <import addon="script.module.requests" version="2.19.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="resources/lib/redlight.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="resources/lib/service.py"/>
    <extension point="xbmc.python.module" library="resources/lib/"/>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>true</reuselanguageinvoker>
        <summary lang="en">[COLOR red]The Red Light[/COLOR]</summary>
        <description lang="en">[COLOR red]* AllDebrid, Offcloud, Premiumize, Real Debrid and TorBox
* AIOStreams
* EasyNews, NZB Indexers and Local Folders
* MDBList, PunchPlay, Simkl, TMDb Lists, Trakt and WeTrakr[/COLOR]</description>
        <platform>all</platform>
        <disclaimer lang="en">[COLOR red]The author of this add-on does not host any content and has no affiliation with the content providers[/COLOR]</disclaimer>
        <license>GPL-3.0</license>
        <assets>
            <icon>resources/media/addon_icons/icon.png</icon>
            <fanart>resources/media/fanart.jpg</fanart>
        </assets>
        <news>[COLOR red]Check the Changelog in Tools > Changelog &amp; Log Utils[/COLOR]</news>
    </extension>
</addon>
<addon id="repository.samlight" name="[COLOR red]Samlight Repository[/COLOR]" version="1.0.0" provider-name="Sam">
    <extension point="xbmc.addon.repository" name="Samlight">
        <dir>
            <info compressed="false">https://fxreza.github.io/samlight/addons.xml</info>
            <checksum>https://fxreza.github.io/samlight/addons.xml.md5</checksum>
            <datadir zip="true">https://fxreza.github.io/samlight/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">[COLOR red]Samlight Repository[/COLOR]</summary>
        <description lang="en">Personal Kodi repository. Hosts Sam Light, a private fork of Red Light by The Red Wizard, rebuilt automatically whenever upstream changes.</description>
        <platform>all</platform>
        <license>GPL-3.0</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
